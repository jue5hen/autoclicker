{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AutoClicker",
  "version": "1.0.0",
  "identifier": "com.dsh.autoclicker",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AutoClicker v1.0.0",
        "width": 1120,
        "height": 720,
        "minWidth": 640,
        "minHeight": 480,
        "resizable": true,
        "maximizable": true,
        "decorations": false,
        "shadow": false,
        "center": true,
        "backgroundColor": "#F5F6F8",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"]
      }
    }
  }
}
